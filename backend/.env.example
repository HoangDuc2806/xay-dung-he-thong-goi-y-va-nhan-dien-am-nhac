ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API /me: Project URL và Publishable key (cũng chấp nhận legacy anon key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Chỉ phục vụ Alembic từ máy quản trị: URI Postgres của Supabase (mật khẩu KHÔNG commit)
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Spotify catalog search: tạo app tại https://developer.spotify.com/dashboard
# Giữ cả hai giá trị ở backend; KHÔNG đặt Client Secret trong frontend/.env.local
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Nhận diện âm nhạc (đăng ký ứng dụng tại https://acoustid.org/new-application)
ACOUSTID_CLIENT_KEY=
# Đường dẫn fpcalc; trên Windows có thể dùng C:\tools\chromaprint\fpcalc.exe
CHROMAPRINT_FPCALC_PATH=fpcalc
RECOGNITION_MAX_UPLOAD_BYTES=20971520
RECOGNITION_FINGERPRINT_LENGTH_SECONDS=120
RECOGNITION_MIN_DURATION_SECONDS=5
RECOGNITION_MAX_DURATION_SECONDS=1800

RECOGNITION_FFMPEG_PATH=ffmpeg

RECOGNITION_FFPROBE_PATH=ffprobe

# hybrid: thuật toán nội bộ trước, AcoustID sau; landmark: chỉ thuật toán đồ án.
RECOGNITION_MODE=hybrid
RECOGNITION_LANDMARK_MIN_VOTES=12
RECOGNITION_LANDMARK_MIN_SCORE=0.05

# Nhận diện micro bằng kho nhạc AudD, không cần tự nạp catalog:
# RECOGNITION_MODE=audd
# Lấy token tại https://dashboard.audd.io/; chỉ đặt ở backend.
AUDD_API_TOKEN=

# Optional; defaults to backend/artifacts/recommender.json (absolute path resolved in code).
# RECOMMENDATION_MODEL_PATH=C:/path/to/recommender.json
# Hai thuật toán nhận diện nội bộ dùng artifact mặc định trong backend/artifacts.
# Chỉ đặt đường dẫn riêng nếu đã tạo bundle + báo cáo tương ứng bằng evaluate_recognition.
# RECOGNITION_LOCAL_BUNDLE=C:/path/to/local_recognition.npz
# RECOGNITION_LOCAL_EVALUATION=C:/path/to/recognition_evaluation.json
